{
    "name": "molehill-cms/website",
    "description": "The main website for the Molehill CMS.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "John Learn",
            "email": "jflearn@logicbrush.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "molehill-cms/kernel": "dev-master",
        "picocss/pico": "^2.1"
    },
    "require-dev": {
        "rector/rector": "^2.4"
    },
    "autoload": {
        "psr-4": { "": "source/" }
    },
    "config": {
        "preferred-install": {
            "molehill-cms/*" : "source",
            "*": "dist"
        },
        "sort-packages": true
    }
}
